{
  "manifest_version": 3,
  "name": "DiffsHub Local",
  "version": "0.1.0",
  "description": "Use DiffsHub with authenticated GitHub pull request diffs from the local browser.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://github.com/*", "https://patch-diff.githubusercontent.com/*", "https://diffshub.com/*"],
  "action": {
    "default_title": "DiffsHub Local"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["src/content-script.js"],
      "css": ["src/content-script.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://diffshub.com/*"],
      "js": ["src/diffshub-page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://diffshub.com/*"],
      "js": ["src/diffshub-content-script.js"],
      "run_at": "document_start"
    }
  ]
}
